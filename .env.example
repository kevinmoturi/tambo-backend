# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - never commit real values.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# MongoDB connection string, including the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tambo?retryWrites=true&w=majority

# --- Auth ------------------------------------------------------------------
# REQUIRED unless NODE_ENV is explicitly development or test - production,
# staging, and an unset NODE_ENV all refuse to boot without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Access token lifetime. Short by design - the refresh token carries longevity.
JWT_ACCESS_TTL=15m
# Refresh token lifetime, i.e. how long a user stays signed in without opening the app.
JWT_REFRESH_TTL_DAYS=30
# bcrypt work factor. 12 is a sane 2020s default; tests drop it to 4 for speed.
BCRYPT_ROUNDS=12
# How long a password reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=60
# Email OTP codes: lifetime, wrong-guess budget per challenge, resend cooldown.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Mail ------------------------------------------------------------------
# console = log the message to stdout (dev), noop = discard (tests),
# resend = deliver via Resend (requires RESEND_API_KEY, and a verified sending
# domain before mail reaches anyone but the Resend account owner - see
# docs/cloudflare.md). Any value that is not a known driver refuses to boot -
# there is deliberately no silent fallback, so OTP codes and reset links can
# never end up in production logs.
MAIL_DRIVER=console
MAIL_FROM=Tambo <no-reply@tambo.app>
RESEND_API_KEY=
# Base used to build password-reset links; a deep link the mobile app handles.
APP_URL=tambo://

# --- Trusted contacts --------------------------------------------------------
# Max contacts per user, consent-link lifetime, nomination resend cooldown.
TRUSTED_CONTACTS_MAX=3
CONSENT_TTL_DAYS=14
NOMINATION_COOLDOWN_SECONDS=300
# Public base URL of this API - used to build consent links a browser opens.
API_PUBLIC_URL=http://localhost:3000

# --- Abuse protection ------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Network ---------------------------------------------------------------
# Number of reverse proxies in front of the app, as an INTEGER (0 = no proxy).
# "true"/other non-numeric values refuse to boot: Express would accept them,
# but they either trust every proxy (X-Forwarded-For becomes forgeable) or
# silently degrade to 0. Set it higher than the real count and clients can
# forge their IP; lower and all traffic shares the load balancer's IP.
TRUST_PROXY=0
# Comma-separated browser origins. Leave EMPTY for a mobile-only API - native
# clients send no Origin header and do not need CORS.
CORS_ALLOWED_ORIGINS=
